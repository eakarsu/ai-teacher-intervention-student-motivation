// Generated schema — modeled after beautyhqio conventions.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  active       Boolean @default(true)
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(ANALYST)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  ADMIN
  MANAGER
  ANALYST
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String?
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())
}

model Classroom {
  id        String   @id @default(cuid())
  name String
  teacher String
  subject String
  gradeLevel String
  enrollment Int
  status String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  students Student[]
  engagementSignals EngagementSignal[]
  learningGaps LearningGap[]
  exerciseRecommendations ExerciseRecommendation[]
  interventions Intervention[]
  motivationalCampaigns MotivationalCampaign[]
  teacherAlerts TeacherAlert[]
  guardianContacts GuardianContact[]
  outcomeMeasures OutcomeMeasure[]
  classHeatmaps ClassHeatmap[]
  resourceLibraryItems ResourceLibraryItem[]
}

model Student {
  id        String   @id @default(cuid())
  name String
  studentId String
  grade String
  engagementScore Float
  status String
  enrolledAt DateTime?
  classroomId String?
  classroom Classroom? @relation(fields: [classroomId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  engagementSignalLinkedstudentId EngagementSignal[] @relation("EngagementSignal_studentId_linked")
  learningGapLinkedstudentId LearningGap[] @relation("LearningGap_studentId_linked")
  interventionLinkedstudentId Intervention[] @relation("Intervention_studentId_linked")
  outcomeMeasureLinkedstudentId OutcomeMeasure[] @relation("OutcomeMeasure_studentId_linked")
}

model EngagementSignal {
  id        String   @id @default(cuid())
  studentRef String
  signalType String
  strength String
  source String
  status String
  observedAt DateTime?
  classroomId String?
  classroom Classroom? @relation(fields: [classroomId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  studentId String?
  studentLinked Student? @relation("EngagementSignal_studentId_linked", fields: [studentId], references: [id], onDelete: Restrict)
}

model LearningGap {
  id        String   @id @default(cuid())
  studentRef String
  concept String
  evidence String
  severity String
  status String
  identifiedAt DateTime?
  classroomId String?
  classroom Classroom? @relation(fields: [classroomId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  studentId String?
  studentLinked Student? @relation("LearningGap_studentId_linked", fields: [studentId], references: [id], onDelete: Restrict)
}

model ExerciseRecommendation {
  id        String   @id @default(cuid())
  studentRef String
  concept String
  exercise String
  difficulty String
  status String
  source String
  classroomId String?
  classroom Classroom? @relation(fields: [classroomId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Intervention {
  id        String   @id @default(cuid())
  studentRef String
  kind String
  plan String
  status String
  startedAt DateTime?
  owner String
  classroomId String?
  classroom Classroom? @relation(fields: [classroomId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  studentId String?
  studentLinked Student? @relation("Intervention_studentId_linked", fields: [studentId], references: [id], onDelete: Restrict)
  outcomeMeasureLinkedinterventionId OutcomeMeasure[] @relation("OutcomeMeasure_interventionId_linked")
}

model MotivationalCampaign {
  id        String   @id @default(cuid())
  name String
  strategy String
  audience String
  status String
  launchedAt DateTime?
  outcome String?
  classroomId String?
  classroom Classroom? @relation(fields: [classroomId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeacherAlert {
  id        String   @id @default(cuid())
  studentRef String
  concern String
  priority String
  status String
  raisedAt DateTime?
  action String?
  classroomId String?
  classroom Classroom? @relation(fields: [classroomId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GuardianContact {
  id        String   @id @default(cuid())
  studentRef String
  guardian String
  channel String
  purpose String
  status String
  sentAt DateTime?
  classroomId String?
  classroom Classroom? @relation(fields: [classroomId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OutcomeMeasure {
  id        String   @id @default(cuid())
  studentRef String
  metric String
  before Float
  after Float
  window String
  status String
  classroomId String?
  classroom Classroom? @relation(fields: [classroomId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  studentId String?
  studentLinked Student? @relation("OutcomeMeasure_studentId_linked", fields: [studentId], references: [id], onDelete: Restrict)
  interventionId String?
  interventionLinked Intervention? @relation("OutcomeMeasure_interventionId_linked", fields: [interventionId], references: [id], onDelete: Restrict)
}

model ClassHeatmap {
  id        String   @id @default(cuid())
  period String
  metric String
  gridRef String
  avgValue Float
  status String
  computedAt DateTime?
  classroomId String?
  classroom Classroom? @relation(fields: [classroomId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ResourceLibraryItem {
  id        String   @id @default(cuid())
  title String
  kind String
  conceptTag String
  url String
  status String
  difficulty String
  classroomId String?
  classroom Classroom? @relation(fields: [classroomId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model WorkflowAnalysis {
 id String @id @default(cuid())
 actorId String
 workflow String
 subjectEntity String
 subjectId String
 input Json
 evidence Json
 evidenceHash String
 result Json
 model String
 receipt String?
 createdAt DateTime @default(now())
 @@index([workflow, createdAt])
}
model RecordReview {
 id String @id @default(cuid())
 actorId String
 entity String
 entityId String
 version String
 reason String
 createdAt DateTime @default(now())
 @@unique([entity, entityId, version, actorId])
}
model UsageBucket {
 id String @id
 calls Int
}
model IssuedCredential {
 token String @id
 entity String
 entityId String
 version String
 assertion Json
 createdAt DateTime @default(now())
 revokedAt DateTime?
 @@index([entity, entityId, createdAt])
}

model DomainArtifact {
 id String @id @default(cuid())
 subjectEntity String
 subjectId String
 title String
 content String
 contentHash String
 actorId String
 approvedBy String?
 createdAt DateTime @default(now())
 @@index([subjectEntity, subjectId])
}

model RecordApproval {
 id String @id
 version String
}
model DomainExecution {
 id String @id
 actorId String
 connectorId String
 action String
 subjectEntity String
 subjectId String
 version String
 status String
 result Json?
 createdAt DateTime @default(now())
}

model WorkSession {
 id String @id @default(cuid())
 actorId String
 respondentId String
 subjectEntity String
 subjectId String
 questions Json
 answers Json
 currentQuestion String?
 status String
 deadline DateTime
 createdAt DateTime @default(now())
 @@index([respondentId, createdAt])
}
model SessionMedia {
 id String @id @default(cuid())
 sessionId String
 questionId String
 actorId String
 contentType String
 bytes Bytes
 contentHash String
 createdAt DateTime @default(now())
 @@index([sessionId])
}
